{
  "name": "@jodetx_dev/secureshield-web",
  "version": "4.0.1",
  "type": "module",
  "description": "SecureShield Enterprise Detection Engine SDK for Web",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": [
    "./dist/secureshield.iife.min.js"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "INTEGRATION_GUIDE.md"
  ],
  "scripts": {
    "build": "tsup",
    "check:diff": "vitest run tests/equivalence.test.ts",
    "check:types": "tsc --noEmit",
    "check:exports": "publint && attw --pack .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "release:check": "npm run check:types && npm test && npm run build && npm run check:exports",
    "release:publish": "npm run release:check && npm publish --access public"
  },
  "keywords": [
    "security",
    "anti-fraud",
    "bot-detection",
    "devtools-detection",
    "ast-hardened",
    "runtime-protection"
  ],
  "author": "SecureShield Team",
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "playwright": "1.63.0",
    "publint": "0.3.25",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "1.6.1"
  }
}
